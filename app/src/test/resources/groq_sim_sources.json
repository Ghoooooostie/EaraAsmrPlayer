[
 {
  "sourceIndex": 0,
  "startMs": 528,
  "endMs": 18234,
  "text": "うん今後も誰かと特別な関係になるつもりはないんです。え"
 },
 {
  "sourceIndex": 1,
  "startMs": 18512,
  "endMs": 30000,
  "text": "誰が相手でもそういった気持ちには応えられなくてはいこれからも今まで通おりよろしくお願いしますね"
 },
 {
  "sourceIndex": 2,
  "startMs": 37536,
  "endMs": 51960,
  "text": "うんそこ誰かいるんですか"
 },
 {
  "sourceIndex": 3,
  "startMs": 51960,
  "endMs": 60000,
  "text": "心声ああ君でしたか"
 },
 {
  "sourceIndex": 4,
  "startMs": 60528,
  "endMs": 68968,
  "text": "こんな時間にまだ残ってたなんて仕事はもう終わったはずですよね"
 },
 {
  "sourceIndex": 5,
  "startMs": 68968,
  "endMs": 81242,
  "text": "まさかまた何か押しつけられたんですかもう会議室は閉めてしまうので用事があるなら"
 },
 {
  "sourceIndex": 6,
  "startMs": 82512,
  "endMs": 90000,
  "text": "あ確かに。今日はネックレスをつけていつもより着飾ってましたね"
 },
 {
  "sourceIndex": 7,
  "startMs": 91520,
  "endMs": 96145,
  "text": "デスクの方はもう捜しましたか?"
 },
 {
  "sourceIndex": 8,
  "startMs": 96145,
  "endMs": 97466,
  "text": "あんな華?"
 },
 {
  "sourceIndex": 9,
  "startMs": 97466,
  "endMs": 100440,
  "text": "?で小さいネックレス"
 },
 {
  "sourceIndex": 10,
  "startMs": 100440,
  "endMs": 110250,
  "text": "君一人じゃ見つけられないでしょ俺はもう帰宅するだけなのでついでですよ"
 },
 {
  "sourceIndex": 11,
  "startMs": 112512,
  "endMs": 120000,
  "text": "君が珍しく職場にアクセサリーをつけて来ていたので覚えてただけです"
 },
 {
  "sourceIndex": 12,
  "startMs": 121520,
  "endMs": 129720,
  "text": "今日は何か予定があったんじゃないんですか?な告白"
 },
 {
  "sourceIndex": 13,
  "startMs": 129720,
  "endMs": 139226,
  "text": "ああそうですかダメだったんですね"
 },
 {
  "sourceIndex": 14,
  "startMs": 139536,
  "endMs": 150000,
  "text": "君に好きな人がいたなんて気付きませんでしたありましたよ"
 },
 {
  "sourceIndex": 15,
  "startMs": 150528,
  "endMs": 158528,
  "text": "チェーンが切れてしまっていますがはいどういたしまして"
 },
 {
  "sourceIndex": 16,
  "startMs": 158528,
  "endMs": 168234,
  "text": "確かに今日は運が悪かったのかもしれませんね君も俺も"
 },
 {
  "sourceIndex": 17,
  "startMs": 169536,
  "endMs": 180000,
  "text": "その人は君の運命の人じゃなかったんですよ"
 },
 {
  "sourceIndex": 18,
  "startMs": 180528,
  "endMs": 195440,
  "text": "こんな天気ですし早く帰りましょう停電"
 },
 {
  "sourceIndex": 19,
  "startMs": 195440,
  "endMs": 210000,
  "text": "少ししたらビルの非常用電源がつくはずですからそこ足元気をつけて危ないから動かないでください"
 },
 {
  "sourceIndex": 20,
  "startMs": 210528,
  "endMs": 219208,
  "text": "大丈夫ですかはあ君は本当に"
 },
 {
  "sourceIndex": 21,
  "startMs": 219208,
  "endMs": 228234,
  "text": "本当にに世話が焼けますね俺がとっさに抱き止めなかったらどうなってたか"
 },
 {
  "sourceIndex": 22,
  "startMs": 229536,
  "endMs": 240000,
  "text": "また君はそうやって俺の前だからって気を抜きすぎです男はみんなお狼"
 },
 {
  "sourceIndex": 23,
  "startMs": 240528,
  "endMs": 248968,
  "text": "なんですよ君は今自分がどれだけ危ない状況か分かってるんですか"
 },
 {
  "sourceIndex": 24,
  "startMs": 248968,
  "endMs": 258234,
  "text": "こうった"
 },
 {
  "sourceIndex": 25,
  "startMs": 258512,
  "endMs": 270000,
  "text": "後ろから抱かれて今俺が本気を出したら逃げられないことくらい理解できますよねそう"
 },
 {
  "sourceIndex": 26,
  "startMs": 270528,
  "endMs": 281728,
  "text": "いや無防備でお人よしでボケッとしてるから俺がいつもフォローしているんですァ"
 },
 {
  "sourceIndex": 27,
  "startMs": 281728,
  "endMs": 290250,
  "text": "はぁ全然分かってないみたいですねファ"
 },
 {
  "sourceIndex": 28,
  "startMs": 290528,
  "endMs": 300000,
  "text": "危ないっていうのはこうやって体を触られて"
 },
 {
  "sourceIndex": 29,
  "startMs": 300528,
  "endMs": 310208,
  "text": "それ以上のこともされかねないって言ってるんですハァ"
 },
 {
  "sourceIndex": 30,
  "startMs": 310208,
  "endMs": 318234,
  "text": "分かりましたあっあ"
 },
 {
  "sourceIndex": 31,
  "startMs": 318512,
  "endMs": 330000,
  "text": "君は今自分がどんな顔してるか分かってるんですか"
 },
 {
  "sourceIndex": 32,
  "startMs": 330528,
  "endMs": 339088,
  "text": "もこんなに近ければ気付きませんどう見てもさっき失恋したばかりの人が"
 },
 {
  "sourceIndex": 33,
  "startMs": 339088,
  "endMs": 348234,
  "text": "していい顔じゃありません君"
 },
 {
  "sourceIndex": 34,
  "startMs": 349536,
  "endMs": 360000,
  "text": "失恋したんですかそんな真っ赤な顔して説得力ありません"
 },
 {
  "sourceIndex": 35,
  "startMs": 368528,
  "endMs": 377848,
  "text": "赤城つきましたねオラいつまで上に乗っかってるんですか今"
 },
 {
  "sourceIndex": 36,
  "startMs": 377848,
  "endMs": 390000,
  "text": "俺に襲われそうになったのにまだそんなボーッとしてっ"
 },
 {
  "sourceIndex": 37,
  "startMs": 392512,
  "endMs": 402032,
  "text": "なんで今俺は大丈夫ですから"
 },
 {
  "sourceIndex": 38,
  "startMs": 402032,
  "endMs": 412234,
  "text": "君はもう帰って下さいほんとにちょっとしためまいですから"
 },
 {
  "sourceIndex": 39,
  "startMs": 413536,
  "endMs": 420000,
  "text": "うっあっすみません"
 },
 {
  "sourceIndex": 40,
  "startMs": 420528,
  "endMs": 429768,
  "text": "あもう失礼します君も気をつけてう"
 },
 {
  "sourceIndex": 41,
  "startMs": 429768,
  "endMs": 438234,
  "text": "あっあっ"
 },
 {
  "sourceIndex": 42,
  "startMs": 459520,
  "endMs": 467720,
  "text": "本日体調不良のため休養させていただきたくあっ"
 },
 {
  "sourceIndex": 43,
  "startMs": 467720,
  "endMs": 480000,
  "text": "その声君ですか昨日あ"
 },
 {
  "sourceIndex": 44,
  "startMs": 480528,
  "endMs": 489888,
  "text": "ことって君は俺の心配なんて"
 },
 {
  "sourceIndex": 45,
  "startMs": 489888,
  "endMs": 498234,
  "text": "誰にでも優しくするからみんなつやがって勘違いして"
 },
 {
  "sourceIndex": 46,
  "startMs": 498512,
  "endMs": 510000,
  "text": "だ大丈夫ですか"
 },
 {
  "sourceIndex": 47,
  "startMs": 511520,
  "endMs": 520120,
  "text": "業務連絡はそれで問題ないのでハァハァ"
 },
 {
  "sourceIndex": 48,
  "startMs": 520120,
  "endMs": 528234,
  "text": "失礼しますフッ"
 },
 {
  "sourceIndex": 49,
  "startMs": 536512,
  "endMs": 540000,
  "text": "心の声あっ"
 },
 {
  "sourceIndex": 50,
  "startMs": 540528,
  "endMs": 549968,
  "text": "すいません早川です何日もお休みを頂いてしまい申し訳あっあ"
 },
 {
  "sourceIndex": 51,
  "startMs": 549968,
  "endMs": 558234,
  "text": "すみませんまだ出勤が難しくて迷惑を"
 },
 {
  "sourceIndex": 52,
  "startMs": 558512,
  "endMs": 570000,
  "text": "うっ君が家に"
 },
 {
  "sourceIndex": 53,
  "startMs": 570528,
  "endMs": 580008,
  "text": "仕事の資料は他の人に頼んでください君俺に襲われそうになったの"
 },
 {
  "sourceIndex": 54,
  "startMs": 580008,
  "endMs": 588234,
  "text": "忘れたんですかもっと危機感を持てってずっと言ってますよ"
 },
 {
  "sourceIndex": 55,
  "startMs": 588512,
  "endMs": 600000,
  "text": "ハァァとにかく君は来ないでさあっ"
 },
 {
  "sourceIndex": 56,
  "startMs": 600528,
  "endMs": 646240,
  "text": "あっ来るなって言いましたよねはぁ分かってますよ"
 },
 {
  "sourceIndex": 57,
  "startMs": 646240,
  "endMs": 660000,
  "text": "君が誰かに頼るのが苦手なことくらい資料ありがとうございましたあとは私が処理しておきますからでは"
 },
 {
  "sourceIndex": 58,
  "startMs": 661520,
  "endMs": 675480,
  "text": "あ何ですかこんなたくさん栄養ドリンクとフルーツと"
 },
 {
  "sourceIndex": 59,
  "startMs": 675480,
  "endMs": 690000,
  "text": "ゼリー冷却シートまで君はフッ"
 },
 {
  "sourceIndex": 60,
  "startMs": 690528,
  "endMs": 705126,
  "text": "自分を襲って手を挙た上司にまで優しいんですねハァフッ"
 },
 {
  "sourceIndex": 61,
  "startMs": 705536,
  "endMs": 720000,
  "text": "人よしすぎて本当にあっ"
 },
 {
  "sourceIndex": 62,
  "startMs": 720528,
  "endMs": 728688,
  "text": "イライラするっ"
 },
 {
  "sourceIndex": 63,
  "startMs": 728688,
  "endMs": 750000,
  "text": "ったまたま上司になった奴が"
 },
 {
  "sourceIndex": 64,
  "startMs": 750528,
  "endMs": 759728,
  "text": "部下をレイプするような男だったなんてかわいそうに"
 },
 {
  "sourceIndex": 65,
  "startMs": 759728,
  "endMs": 770250,
  "text": "あの時本当にキスしなかったから油断してました言いましたよね何度も何度もそれなのに"
 },
 {
  "sourceIndex": 66,
  "startMs": 770528,
  "endMs": 780000,
  "text": "君はくそ"
 },
 {
  "sourceIndex": 67,
  "startMs": 780528,
  "endMs": 789568,
  "text": "ハッハッまだ俺の心配してくれるんですか体がおかしいのは"
 },
 {
  "sourceIndex": 68,
  "startMs": 789568,
  "endMs": 794382,
  "text": "本当ですよ"
 },
 {
  "sourceIndex": 69,
  "startMs": 794382,
  "endMs": 798234,
  "text": "はあハァ"
 },
 {
  "sourceIndex": 70,
  "startMs": 799536,
  "endMs": 810000,
  "text": "になりすぎて仕事に行けなかったなんて言っても優しい君ならきっと信じてくれますよね"
 },
 {
  "sourceIndex": 71,
  "startMs": 811520,
  "endMs": 819840,
  "text": "ならどんなに遺伝性の特殊体質なんです好きな人に自分の"
 },
 {
  "sourceIndex": 72,
  "startMs": 819840,
  "endMs": 828234,
  "text": "思いを伝えないと感情が爆発してこんなハァ"
 },
 {
  "sourceIndex": 73,
  "startMs": 828512,
  "endMs": 840000,
  "text": "ほらこれズボン越しでも分かるでしょダメって"
 },
 {
  "sourceIndex": 74,
  "startMs": 840528,
  "endMs": 855000,
  "text": "信号も確かにいつもより少し大きいけどそれじゃなくてその"
 },
 {
  "sourceIndex": 75,
  "startMs": 855000,
  "endMs": 870000,
  "text": "知ったのわかりますかパンパンになっていつもの3倍くらい大きくなってるんです一回この"
 },
 {
  "sourceIndex": 76,
  "startMs": 870528,
  "endMs": 879448,
  "text": "顔を切ると出し切るまで何回出してもずっと勃帰と射生を繰り返して"
 },
 {
  "sourceIndex": 77,
  "startMs": 879448,
  "endMs": 888234,
  "text": "したあっ"
 },
 {
  "sourceIndex": 78,
  "startMs": 888512,
  "endMs": 900000,
  "text": "おかしいでしょ恋心こそ"
 },
 {
  "sourceIndex": 79,
  "startMs": 900528,
  "endMs": 912808,
  "text": "こんなになって好きな人に気持ちを伝えればって"
 },
 {
  "sourceIndex": 80,
  "startMs": 912808,
  "endMs": 921242,
  "text": "君はこんなおかしい体の男とつき合いたいと思いますか"
 },
 {
  "sourceIndex": 81,
  "startMs": 921520,
  "endMs": 930000,
  "text": "こんな体君に無理やり"
 },
 {
  "sourceIndex": 82,
  "startMs": 930528,
  "endMs": 939168,
  "text": "キスしたはあ"
 },
 {
  "sourceIndex": 83,
  "startMs": 939168,
  "endMs": 949226,
  "text": "君の手が触れるだけで興奮してはらませたくてあと"
 },
 {
  "sourceIndex": 84,
  "startMs": 949536,
  "endMs": 960000,
  "text": "おかしくなるだから死ぬ"
 },
 {
  "sourceIndex": 85,
  "startMs": 960528,
  "endMs": 968608,
  "text": "勝んですだから今まで感情を押し殺して"
 },
 {
  "sourceIndex": 86,
  "startMs": 968608,
  "endMs": 978234,
  "text": "俺に誰かを思う資格なんてないんですハァ"
 },
 {
  "sourceIndex": 87,
  "startMs": 979536,
  "endMs": 990000,
  "text": "フッそんなことないなんてよく言えますね俺みたいな奴を受け入れてくれる人が"
 },
 {
  "sourceIndex": 88,
  "startMs": 990528,
  "endMs": 999888,
  "text": "って本当に思ってるんですかこんなおかしな体でも腹ませて縛りつけてどこにも逃がさないように"
 },
 {
  "sourceIndex": 89,
  "startMs": 999888,
  "endMs": 1009226,
  "text": "誰の目にも触れないようにしたいって体が動くんですそんな男でも"
 },
 {
  "sourceIndex": 90,
  "startMs": 1012512,
  "endMs": 1020000,
  "text": "なら証明しろ"
 },
 {
  "sourceIndex": 91,
  "startMs": 1020528,
  "endMs": 1035520,
  "text": "俺を受け入れてくれる人がいるって君が君が言ったんですからああそうださっき言い忘れてたんですけど"
 },
 {
  "sourceIndex": 92,
  "startMs": 1035520,
  "endMs": 1050000,
  "text": "この症状100回射生しないと治らないんですでも優しい君なら俺のこと受け入れて治してくれますよね?"
 },
 {
  "sourceIndex": 93,
  "startMs": 1059520,
  "endMs": 1069120,
  "text": "はぁもう逃げられませんね"
 },
 {
  "sourceIndex": 94,
  "startMs": 1069120,
  "endMs": 1090040,
  "text": "あっうんはあキス"
 },
 {
  "sourceIndex": 95,
  "startMs": 1090040,
  "endMs": 1098234,
  "text": "下手すぎだ液たれちゃったはあ"
 },
 {
  "sourceIndex": 96,
  "startMs": 1098512,
  "endMs": 1110000,
  "text": "もう力抜けちゃったんですかハァ"
 },
 {
  "sourceIndex": 97,
  "startMs": 1110528,
  "endMs": 1125120,
  "text": "うそんな店"
 },
 {
  "sourceIndex": 98,
  "startMs": 1125120,
  "endMs": 1140000,
  "text": "詰められてもやめませんよほら服脱いで俺も?"
 },
 {
  "sourceIndex": 99,
  "startMs": 1142512,
  "endMs": 1152192,
  "text": "進コ大きくなりすぎて泣きにくいあっああ"
 },
 {
  "sourceIndex": 100,
  "startMs": 1152192,
  "endMs": 1160250,
  "text": "何ァを驚いてるんですか大きさなんて今更さっき触って"
 },
 {
  "sourceIndex": 101,
  "startMs": 1160528,
  "endMs": 1170000,
  "text": "でしょそれより早く君も脱ぐんですよ"
 },
 {
  "sourceIndex": 102,
  "startMs": 1172512,
  "endMs": 1186400,
  "text": "は俺下は脱がせてあげますからう"
 },
 {
  "sourceIndex": 103,
  "startMs": 1186400,
  "endMs": 1191345,
  "text": "はぁあれ下着の色"
 },
 {
  "sourceIndex": 104,
  "startMs": 1191345,
  "endMs": 1200000,
  "text": "ここだけ色が変わってますね栗"
 },
 {
  "sourceIndex": 105,
  "startMs": 1200528,
  "endMs": 1215520,
  "text": "勃起してる栗こんな大きくなってァ高校"
 },
 {
  "sourceIndex": 106,
  "startMs": 1215520,
  "endMs": 1230000,
  "text": "ここいつも使いすぎなんじゃないですかフフッほら足ピンしないで"
 },
 {
  "sourceIndex": 107,
  "startMs": 1230528,
  "endMs": 1239728,
  "text": "下着脱がしますよはあやっぱり"
 },
 {
  "sourceIndex": 108,
  "startMs": 1239728,
  "endMs": 1248234,
  "text": "もうこんな糸引いてふう"
 },
 {
  "sourceIndex": 109,
  "startMs": 1260528,
  "endMs": 1270128,
  "text": "キしただけなのにもしかして久しぶりでしたか?"
 },
 {
  "sourceIndex": 110,
  "startMs": 1270128,
  "endMs": 1278234,
  "text": "は初めてってく君は"
 },
 {
  "sourceIndex": 111,
  "startMs": 1278512,
  "endMs": 1290000,
  "text": "どこまでくっ"
 },
 {
  "sourceIndex": 112,
  "startMs": 1290528,
  "endMs": 1300208,
  "text": "もし逃げないで汚くないですからはあ"
 },
 {
  "sourceIndex": 113,
  "startMs": 1300208,
  "endMs": 1308234,
  "text": "さっき君が見てたオレのガンゾリチンコ入るようにしないと"
 },
 {
  "sourceIndex": 114,
  "startMs": 1308512,
  "endMs": 1320000,
  "text": "いけないでしょうん"
 },
 {
  "sourceIndex": 115,
  "startMs": 1321520,
  "endMs": 1336000,
  "text": "ァなめながらロッキクリトリスちゃんと舌でぬいてあげますから"
 },
 {
  "sourceIndex": 116,
  "startMs": 1336000,
  "endMs": 1350000,
  "text": "ああううん"
 },
 {
  "sourceIndex": 117,
  "startMs": 1350528,
  "endMs": 1358528,
  "text": "くつがこれこれあああ"
 },
 {
  "sourceIndex": 118,
  "startMs": 1358528,
  "endMs": 1368234,
  "text": "指も中に"
 },
 {
  "sourceIndex": 119,
  "startMs": 1369536,
  "endMs": 1380000,
  "text": "あきっつマンコ指しめすぎ動かせないじゃないですかなんて"
 },
 {
  "sourceIndex": 120,
  "startMs": 1380528,
  "endMs": 1388688,
  "text": "ちゃんとなんかおれのチンコ入れる練習しないと"
 },
 {
  "sourceIndex": 121,
  "startMs": 1388688,
  "endMs": 1398234,
  "text": "クリした"
 },
 {
  "sourceIndex": 122,
  "startMs": 1398512,
  "endMs": 1404454,
  "text": "すごい立こしたほが力ぬけますか?"
 },
 {
  "sourceIndex": 123,
  "startMs": 1404454,
  "endMs": 1410000,
  "text": "はあもっとビクビクしちゃった"
 },
 {
  "sourceIndex": 124,
  "startMs": 1410528,
  "endMs": 1419488,
  "text": "こここですかん"
 },
 {
  "sourceIndex": 125,
  "startMs": 1419488,
  "endMs": 1440000,
  "text": "うん心声あこくねらせて分かりやすいああ"
 },
 {
  "sourceIndex": 126,
  "startMs": 1442512,
  "endMs": 1470000,
  "text": "ああ俺のチコも正ぎパンパンだ硬たくなりすぎたあうん"
 },
 {
  "sourceIndex": 127,
  "startMs": 1472512,
  "endMs": 1480592,
  "text": "あっ俺も自分んだああ"
 },
 {
  "sourceIndex": 128,
  "startMs": 1480592,
  "endMs": 1489226,
  "text": "ああつごんあっ"
 },
 {
  "sourceIndex": 129,
  "startMs": 1489536,
  "endMs": 1500000,
  "text": "君の首おれのチンコみたいにかな俺びっくり"
 },
 {
  "sourceIndex": 130,
  "startMs": 1500528,
  "endMs": 1510008,
  "text": "ハハ行く準備してるはあ"
 },
 {
  "sourceIndex": 131,
  "startMs": 1510008,
  "endMs": 1518234,
  "text": "栗と中どっちでいくんですかハハ分かんない"
 },
 {
  "sourceIndex": 132,
  "startMs": 1518512,
  "endMs": 1530000,
  "text": "中も首もけれさすっご震え行ってした"
 },
 {
  "sourceIndex": 133,
  "startMs": 1530528,
  "endMs": 1539208,
  "text": "たくさん行ってオの受け入れる準備してさほらほら"
 },
 {
  "sourceIndex": 134,
  "startMs": 1539208,
  "endMs": 1560000,
  "text": "うんいいかいいかいくかいいかいかいか"
 },
 {
  "sourceIndex": 135,
  "startMs": 1560528,
  "endMs": 1578234,
  "text": "んうんうんうんフ"
 },
 {
  "sourceIndex": 136,
  "startMs": 1578512,
  "endMs": 1590000,
  "text": "やめないですよやっと力抜けたんですから指増やしたあっあ"
 },
 {
  "sourceIndex": 137,
  "startMs": 1590528,
  "endMs": 1599728,
  "text": "かわいい足ピンしながら腰ガクガク浮かせて"
 },
 {
  "sourceIndex": 138,
  "startMs": 1599728,
  "endMs": 1609226,
  "text": "器用ですね嫌じゃないでしょ"
 },
 {
  "sourceIndex": 139,
  "startMs": 1610528,
  "endMs": 1620000,
  "text": "刀っくりしたら殺したす"
 },
 {
  "sourceIndex": 140,
  "startMs": 1620528,
  "endMs": 1629008,
  "text": "もっと気持ちいいでしょうダメじゃ何回でもハァ"
 },
 {
  "sourceIndex": 141,
  "startMs": 1629008,
  "endMs": 1638234,
  "text": "うんあっ"
 },
 {
  "sourceIndex": 142,
  "startMs": 1644528,
  "endMs": 1650000,
  "text": "あっハハあす"
 },
 {
  "sourceIndex": 143,
  "startMs": 1652512,
  "endMs": 1666280,
  "text": "シがジ吾にかかってあったかくてアァ気持ちいいもっともっとおかしくなってくださいハァ"
 },
 {
  "sourceIndex": 144,
  "startMs": 1666280,
  "endMs": 1680000,
  "text": "ずっと行きっぱなしで万黒主所潮吹くの止まんらないですねハあっ"
 },
 {
  "sourceIndex": 145,
  "startMs": 1680528,
  "endMs": 1695520,
  "text": "あっまだまだ出"
 },
 {
  "sourceIndex": 146,
  "startMs": 1695520,
  "endMs": 1710000,
  "text": "そうそうだこうやってマンゴにこうやってこすりつければ藍雪とまざってローションがわりになりますねああ"
 },
 {
  "sourceIndex": 147,
  "startMs": 1710528,
  "endMs": 1719688,
  "text": "マンコのけいらん伝わってきて気持ちいい君が来てからずっと我慢してきっとまでパンパンになった"
 },
 {
  "sourceIndex": 148,
  "startMs": 1719688,
  "endMs": 1732234,
  "text": "あまだぐぐああああああ"
 },
 {
  "sourceIndex": 149,
  "startMs": 1732512,
  "endMs": 1740000,
  "text": "あっ君もこう"
 },
 {
  "sourceIndex": 150,
  "startMs": 1740528,
  "endMs": 1748648,
  "text": "グググしたまた言ったんですかこんな強引にされてるのに何度も私フ"
 },
 {
  "sourceIndex": 151,
  "startMs": 1748648,
  "endMs": 1759226,
  "text": "騎して何へばってるんですかほら顔隠さないでこっち向いてくださいあ"
 },
 {
  "sourceIndex": 152,
  "startMs": 1759536,
  "endMs": 1770000,
  "text": "フフフ泣くほど嫌ですか"
 },
 {
  "sourceIndex": 153,
  "startMs": 1770528,
  "endMs": 1779928,
  "text": "でももう遅いですからあっ"
 },
 {
  "sourceIndex": 154,
  "startMs": 1779928,
  "endMs": 1788234,
  "text": "君が職場の誰を好きだったかな知らないけど"
 },
 {
  "sourceIndex": 155,
  "startMs": 1788512,
  "endMs": 1800000,
  "text": "もうオレと約束しちゃいましたもんね失恋万こでオレの聖域しぼり取って治してくれるって"
 },
 {
  "sourceIndex": 156,
  "startMs": 1800528,
  "endMs": 1815520,
  "text": "さっきすごい出たから君ががんばれば早く終われるかもしれませんよああでもこんなちっちゃい穴じゃまだオレのチンコくわえられないですね"
 },
 {
  "sourceIndex": 157,
  "startMs": 1815520,
  "endMs": 1830000,
  "text": "しょうがないなほらこっちの口はくわえられるでしょ君は寝たままだ俺が上にハァハハッ"
 },
 {
  "sourceIndex": 158,
  "startMs": 1830528,
  "endMs": 1839528,
  "text": "口おっきく開いて舌ベて出して祈<unk>パンパンに膨らんでるから"
 },
 {
  "sourceIndex": 159,
  "startMs": 1839528,
  "endMs": 1848234,
  "text": "先っぽだけでいいですよ包み込む感じじゃあっそう"
 },
 {
  "sourceIndex": 160,
  "startMs": 1848512,
  "endMs": 1860000,
  "text": "君のマンークをもっと広げないといけないから反対側向きますねそのままくわえてて"
 },
 {
  "sourceIndex": 161,
  "startMs": 1860528,
  "endMs": 1869128,
  "text": "ハハハ君のいつもヘラヘラ笑ってる口に俺のチンコピッタ"
 },
 {
  "sourceIndex": 162,
  "startMs": 1869128,
  "endMs": 1878234,
  "text": "とりあいちゃおマン子指で広げて舌突っ込んだ"
 },
 {
  "sourceIndex": 163,
  "startMs": 1878512,
  "endMs": 1890000,
  "text": "うっと声れて気持ちいいですかもっと奥まで入れてあげますか"
 },
 {
  "sourceIndex": 164,
  "startMs": 1890528,
  "endMs": 1908234,
  "text": "うんあっ"
 },
 {
  "sourceIndex": 165,
  "startMs": 1908512,
  "endMs": 1920000,
  "text": "君が失恋した人きっとイラまで口塞さいない修復まで苦にしない普通の人なんでしょうな告白がうまくいってれば今頃で"
 },
 {
  "sourceIndex": 166,
  "startMs": 1921520,
  "endMs": 1929520,
  "text": "普通のセックスしてたはずなのにこんな怖い上司に襲われては"
 },
 {
  "sourceIndex": 167,
  "startMs": 1929520,
  "endMs": 1938234,
  "text": "くわえながらもごもご言っても分かんないです"
 },
 {
  "sourceIndex": 168,
  "startMs": 1938512,
  "endMs": 1950000,
  "text": "俺は顔を動かさないでのき祈っとだけでいい"
 },
 {
  "sourceIndex": 169,
  "startMs": 1950528,
  "endMs": 1965040,
  "text": "苦しいくせに何ちっちゃい舌も動いてであもうあっそんな頑張んなくて"
 },
 {
  "sourceIndex": 170,
  "startMs": 1965040,
  "endMs": 1980000,
  "text": "ああ我慢できない動きますかマンゴいたいスタイルだ"
 },
 {
  "sourceIndex": 171,
  "startMs": 1980528,
  "endMs": 2005242,
  "text": "ぐ上の下も撮ル撮ネと俺に俺に侵されてるって本っと感じたけどさ何か言ってる"
 },
 {
  "sourceIndex": 172,
  "startMs": 2005520,
  "endMs": 2010000,
  "text": "心臓でああっ"
 },
 {
  "sourceIndex": 173,
  "startMs": 2010528,
  "endMs": 2025000,
  "text": "ああ濃くて熱い数君の口の中ああ"
 },
 {
  "sourceIndex": 174,
  "startMs": 2025000,
  "endMs": 2040000,
  "text": "あっごん体重かけさせてああっ"
 },
 {
  "sourceIndex": 175,
  "startMs": 2040528,
  "endMs": 2049608,
  "text": "喉の動きが伝わってくるごめん"
 },
 {
  "sourceIndex": 176,
  "startMs": 2049608,
  "endMs": 2063226,
  "text": "苦しいですの月の下離れ下ごめんなさいあっ行くのともああっ"
 },
 {
  "sourceIndex": 177,
  "startMs": 2063536,
  "endMs": 2070000,
  "text": "あっあっあっああああああ"
 },
 {
  "sourceIndex": 178,
  "startMs": 2073536,
  "endMs": 2081856,
  "text": "はあはあはあはあはあはああっああああうん"
 },
 {
  "sourceIndex": 179,
  "startMs": 2081856,
  "endMs": 2100000,
  "text": "おもせはァ君大丈夫ですか?"
 },
 {
  "sourceIndex": 180,
  "startMs": 2101520,
  "endMs": 2116240,
  "text": "ハハアハハアハあ顔ぐっちゃぐちゃ涙も精子もドロドロに混ざって汚いな"
 },
 {
  "sourceIndex": 181,
  "startMs": 2116240,
  "endMs": 2140960,
  "text": "俺レに? されて汚されちゃいましたねおっと遠いうん。うんん"
 },
 {
  "sourceIndex": 182,
  "startMs": 2140960,
  "endMs": 2151242,
  "text": "ハァずっと潮吹いてたからけうれんしてマンゴーパクパクしてますよ"
 },
 {
  "sourceIndex": 183,
  "startMs": 2151520,
  "endMs": 2160000,
  "text": "ジンコを欲しがってるみたいで興奮するおらちゃんとマンコ"
 },
 {
  "sourceIndex": 184,
  "startMs": 2160528,
  "endMs": 2175360,
  "text": "抵抗しないとこのまま入っちゃいますよあっちチッチ君のマン子に押しつけ"
 },
 {
  "sourceIndex": 185,
  "startMs": 2175360,
  "endMs": 2190000,
  "text": "見だけでも気持ちいいですほら逃げちゃごめ腰しっかり押さえつけて体押し潰ぶしてそんなに怖がらないでくれ"
 },
 {
  "sourceIndex": 186,
  "startMs": 2190528,
  "endMs": 2199688,
  "text": "それにちゃんとこのマンコで抵抗すればいいでしょああでももうここグチュグチュってしてるから入っちゃいそうクリ"
 },
 {
  "sourceIndex": 187,
  "startMs": 2199688,
  "endMs": 2209226,
  "text": "押し潰したらはあ"
 },
 {
  "sourceIndex": 188,
  "startMs": 2209536,
  "endMs": 2220000,
  "text": "ああ入っちゃいましたねはあ"
 },
 {
  "sourceIndex": 189,
  "startMs": 2220528,
  "endMs": 2230528,
  "text": "君の心オレじゃない人を思ってるのに入ってくるのは"
 },
 {
  "sourceIndex": 190,
  "startMs": 2230528,
  "endMs": 2239226,
  "text": "君をはらませたがって脈打ってるガンゾリチンコだかわいそうにあ"
 },
 {
  "sourceIndex": 191,
  "startMs": 2239536,
  "endMs": 2250000,
  "text": "ハハ気持ちいいとこ当たったんですか体ビクッてしちゃって"
 },
 {
  "sourceIndex": 192,
  "startMs": 2250528,
  "endMs": 2265280,
  "text": "佐液と藍液が混ざってドロトロドロドロ中きまだ奥くまで入れてないのに"
 },
 {
  "sourceIndex": 193,
  "startMs": 2265280,
  "endMs": 2280000,
  "text": "オれの精子しぼり取ろうとして娘ずっとねってこうやってジンコが出ていくこう"
 },
 {
  "sourceIndex": 194,
  "startMs": 2280528,
  "endMs": 2291408,
  "text": "首ギュッって締めつけてくる行かないでって言ってるみたいであああ何回もしたくなる"
 },
 {
  "sourceIndex": 195,
  "startMs": 2291408,
  "endMs": 2300250,
  "text": "ああ癖になりそうですぐあっ"
 },
 {
  "sourceIndex": 196,
  "startMs": 2300528,
  "endMs": 2307895,
  "text": "こここすられるのすきですよね"
 },
 {
  "sourceIndex": 197,
  "startMs": 2307895,
  "endMs": 2310000,
  "text": "ささあの"
 },
 {
  "sourceIndex": 198,
  "startMs": 2310528,
  "endMs": 2322128,
  "text": "無祈道で押しつぶしてあげますからもしかしてさっきから軽く言ってますまた締めつける"
 },
 {
  "sourceIndex": 199,
  "startMs": 2322128,
  "endMs": 2332234,
  "text": "かわいい信ンコでこすられて気持ちいいんですがおかしくなっちゃうハもっと"
 },
 {
  "sourceIndex": 200,
  "startMs": 2332512,
  "endMs": 2340000,
  "text": "ほもっとおかしくなってください俺と同じ君も壊れて"
 },
 {
  "sourceIndex": 201,
  "startMs": 2340528,
  "endMs": 2355200,
  "text": "おそろいに"
 },
 {
  "sourceIndex": 202,
  "startMs": 2355200,
  "endMs": 2370000,
  "text": "ねえねえ嫌った言わないでください君が受け入れてくれるって言ったんだから最後まで責任持って責任あっそう"
 },
 {
  "sourceIndex": 203,
  "startMs": 2370528,
  "endMs": 2385480,
  "text": "結婚結婚した俺と結婚した責任取ってくださいっまずは彼女から始めましょうか俺に告白して好きって言ってみてください"
 },
 {
  "sourceIndex": 204,
  "startMs": 2385480,
  "endMs": 2400000,
  "text": "ほら好き好きって好き好き好き好き違う何も違わないでしょ君は俺の言葉を繰り返してればいいんですほら言った好き好きったッハハッ"
 },
 {
  "sourceIndex": 205,
  "startMs": 2400528,
  "endMs": 2415480,
  "text": "はァ好きってうそでも言ってくれないんですねあっ"
 },
 {
  "sourceIndex": 206,
  "startMs": 2415480,
  "endMs": 2430000,
  "text": "あっはあは"
 },
 {
  "sourceIndex": 207,
  "startMs": 2430528,
  "endMs": 2438808,
  "text": "じゃないば僕のチンコは気持ちよくなっちゃうイラ文ンコにたくさん精神を注いであげますからねああ"
 },
 {
  "sourceIndex": 208,
  "startMs": 2438808,
  "endMs": 2448234,
  "text": "クリクリククイクイあっああああああ"
 },
 {
  "sourceIndex": 209,
  "startMs": 2448512,
  "endMs": 2460000,
  "text": "ああ止まんないあっ"
 },
 {
  "sourceIndex": 210,
  "startMs": 2460528,
  "endMs": 2475240,
  "text": "ジュンコビクビクってしてるのわかりますか君の子宮に精しいっぱい"
 },
 {
  "sourceIndex": 211,
  "startMs": 2475240,
  "endMs": 2490000,
  "text": "お送り込んで強制結婚できるようにってもう一回奥までああああ"
 },
 {
  "sourceIndex": 212,
  "startMs": 2490528,
  "endMs": 2493611,
  "text": "やっと全部入った"
 },
 {
  "sourceIndex": 213,
  "startMs": 2493611,
  "endMs": 2495152,
  "text": "はあ、気い"
 },
 {
  "sourceIndex": 214,
  "startMs": 2495152,
  "endMs": 2499008,
  "text": "至宮管潰してちょっと"
 },
 {
  "sourceIndex": 215,
  "startMs": 2499008,
  "endMs": 2508234,
  "text": "くせそいではきますからうん"
 },
 {
  "sourceIndex": 216,
  "startMs": 2508512,
  "endMs": 2520000,
  "text": "だけどの刺激だ"
 },
 {
  "sourceIndex": 217,
  "startMs": 2520528,
  "endMs": 2529208,
  "text": "また行こう会い行"
 },
 {
  "sourceIndex": 218,
  "startMs": 2529208,
  "endMs": 2538234,
  "text": "うかかわいい"
 },
 {
  "sourceIndex": 219,
  "startMs": 2538512,
  "endMs": 2550000,
  "text": "ああこんなのこと"
 },
 {
  "sourceIndex": 220,
  "startMs": 2550528,
  "endMs": 2589088,
  "text": "くああああはあ"
 },
 {
  "sourceIndex": 221,
  "startMs": 2589088,
  "endMs": 2598234,
  "text": "うんうん"
 },
 {
  "sourceIndex": 222,
  "startMs": 2607536,
  "endMs": 2610000,
  "text": "清舟、おなか膨く"
 },
 {
  "sourceIndex": 223,
  "startMs": 2611520,
  "endMs": 2625640,
  "text": "一回抜いときますすま"
 },
 {
  "sourceIndex": 224,
  "startMs": 2625640,
  "endMs": 2640000,
  "text": "声ですおマンゴから射生してるみたいおれの片隅広がってパクパクしとる専用マンゴから精液たらラたらラ垂れ流してふァ"
 },
 {
  "sourceIndex": 225,
  "startMs": 2640528,
  "endMs": 2648688,
  "text": "今おなか押したらもう一回射生できますか俺おなか力入れてキュー"
 },
 {
  "sourceIndex": 226,
  "startMs": 2648688,
  "endMs": 2658234,
  "text": "ああすっかまた俺の性癖で射生しちゃってる"
 },
 {
  "sourceIndex": 227,
  "startMs": 2658512,
  "endMs": 2670000,
  "text": "ふたしてあげますねあああったかくてきつい"
 },
 {
  "sourceIndex": 228,
  "startMs": 2670528,
  "endMs": 2679728,
  "text": "飛んじゃってる意識ないのに締めつけて怖いいハァハハァ"
 },
 {
  "sourceIndex": 229,
  "startMs": 2679728,
  "endMs": 2700000,
  "text": "すげえ好きですはあ"
 },
 {
  "sourceIndex": 230,
  "startMs": 2700528,
  "endMs": 2706041,
  "text": "ずっとこのまま君と壊れてたら好き"
 },
 {
  "sourceIndex": 231,
  "startMs": 2706041,
  "endMs": 2710865,
  "text": "好き、好きになってごめんなさい"
 },
 {
  "sourceIndex": 232,
  "startMs": 2710865,
  "endMs": 2713277,
  "text": "大好きなんです"
 },
 {
  "sourceIndex": 233,
  "startMs": 2713277,
  "endMs": 2715000,
  "text": "言く苦しい"
 },
 {
  "sourceIndex": 234,
  "startMs": 2715000,
  "endMs": 2730000,
  "text": "けどこれが俺の好きなんですごめんなさい好きで愛してしまった"
 },
 {
  "sourceIndex": 235,
  "startMs": 2730528,
  "endMs": 2739808,
  "text": "ひどいことしてるのにまだ勃ケして興奮して最低です"
 },
 {
  "sourceIndex": 236,
  "startMs": 2739808,
  "endMs": 2748234,
  "text": "俺のせいで苦しくなってるかわいそうな君に興奮してごめんごめんごめん"
 },
 {
  "sourceIndex": 237,
  "startMs": 2748512,
  "endMs": 2760000,
  "text": "でも好き好きなんです好き好き俺が一番君を愛してる"
 },
 {
  "sourceIndex": 238,
  "startMs": 2761520,
  "endMs": 2790000,
  "text": "すえすえ。いああ"
 },
 {
  "sourceIndex": 239,
  "startMs": 2790528,
  "endMs": 2839126,
  "text": "うんキム?はっ"
 },
 {
  "sourceIndex": 240,
  "startMs": 2840528,
  "endMs": 2845142,
  "text": "あっあっ"
 },
 {
  "sourceIndex": 241,
  "startMs": 2847536,
  "endMs": 2850000,
  "text": "出なかったんですね"
 },
 {
  "sourceIndex": 242,
  "startMs": 2854528,
  "endMs": 2866600,
  "text": "まだオの心配をしてくれるんですか喉今までこんな大きな声を出したりその"
 },
 {
  "sourceIndex": 243,
  "startMs": 2866600,
  "endMs": 2880000,
  "text": "泣いてしまったりしたことがなかったのでその反動であ体の方は"
 },
 {
  "sourceIndex": 244,
  "startMs": 2880528,
  "endMs": 2889408,
  "text": "治ってはいませんがだいぶよくなりました君のおかげで"
 },
 {
  "sourceIndex": 245,
  "startMs": 2889408,
  "endMs": 2898234,
  "text": "はっほんとうそみたいな体質ですよね"
 },
 {
  "sourceIndex": 246,
  "startMs": 2898512,
  "endMs": 2910000,
  "text": "好きな人に自分の思いを伝えないと感情が爆発して何度もってでも単純な話人を好きにならなければ"
 },
 {
  "sourceIndex": 247,
  "startMs": 2910528,
  "endMs": 2922128,
  "text": "感情を制御して小さい頃は大変でしたけどどんな思いも時間がたてば落ち着くんです"
 },
 {
  "sourceIndex": 248,
  "startMs": 2922128,
  "endMs": 2931242,
  "text": "ほらアンガーマネージメントで6秒我慢するとかよく言うでしょあれと同じです"
 },
 {
  "sourceIndex": 249,
  "startMs": 2931520,
  "endMs": 2940000,
  "text": "でも好きになってしまってからは感情のコントロールが全然ダメで"
 },
 {
  "sourceIndex": 250,
  "startMs": 2940528,
  "endMs": 2949928,
  "text": "それでも発症しないようにいろいろ工夫してあ"
 },
 {
  "sourceIndex": 251,
  "startMs": 2949928,
  "endMs": 2961242,
  "text": "その服は昨日君の服が汚れてしまったからその代わりにはァ"
 },
 {
  "sourceIndex": 252,
  "startMs": 2961520,
  "endMs": 2970000,
  "text": "やっぱり気づきますよね君がよく職場で着てる服と同じですあ"
 },
 {
  "sourceIndex": 253,
  "startMs": 2970528,
  "endMs": 2985160,
  "text": "その気持ちを抑えるために買っていたのですが最近はただ君に似合う服を見つけるとつい買ってしまって気持ち悪いですよね"
 },
 {
  "sourceIndex": 254,
  "startMs": 2985160,
  "endMs": 3000000,
  "text": "君は何で逃げなかったんですか起きた時俺がいなかったでしょ拘束具をつけてなかったし"
 },
 {
  "sourceIndex": 255,
  "startMs": 3001520,
  "endMs": 3010120,
  "text": "どこも不自由になってなかったはずです君の優しさにつけ込んで"
 },
 {
  "sourceIndex": 256,
  "startMs": 3010120,
  "endMs": 3018234,
  "text": "こんなシでもない頭も体もおかしな男に襲われて"
 },
 {
  "sourceIndex": 257,
  "startMs": 3018512,
  "endMs": 3030000,
  "text": "どうして君のその顔は無意識かもしれませんが男を勘違いさせるからやめた方がいい"
 },
 {
  "sourceIndex": 258,
  "startMs": 3030528,
  "endMs": 3039288,
  "text": "君は優しいから治療だとかおかしなことに巻き込まれて酷い目に"
 },
 {
  "sourceIndex": 259,
  "startMs": 3039288,
  "endMs": 3053226,
  "text": "すみませんこんな勝手なこと言ってでも君が君のことが好きで抑えられなくて"
 },
 {
  "sourceIndex": 260,
  "startMs": 3053536,
  "endMs": 3060000,
  "text": "情けないところを見せてばかりで本当かっ悪いハァ"
 },
 {
  "sourceIndex": 261,
  "startMs": 3060528,
  "endMs": 3075400,
  "text": "君ですよ君が好きなんですずっと言ってるじゃないですか俺はセックスの時だけ都合よく好きだとか言う男じゃありません本気で"
 },
 {
  "sourceIndex": 262,
  "startMs": 3075400,
  "endMs": 3090000,
  "text": "あなたのことがあな何でそんな顔赤くなってるんですかこの前の会議室でも君はそんなかわいい顔をしてあ"
 },
 {
  "sourceIndex": 263,
  "startMs": 3090528,
  "endMs": 3100322,
  "text": "好き君が俺をいやでも君は失恋した"
 },
 {
  "sourceIndex": 264,
  "startMs": 3100322,
  "endMs": 3115242,
  "text": "はじゃああなたは俺の告白の返事を聞いて勝手にフラてたってことですか"
 },
 {
  "sourceIndex": 265,
  "startMs": 3115520,
  "endMs": 3120000,
  "text": "ああああ"
 },
 {
  "sourceIndex": 266,
  "startMs": 3127536,
  "endMs": 3136216,
  "text": "でもそれは俺が君を襲う前のことでしょ"
 },
 {
  "sourceIndex": 267,
  "startMs": 3136216,
  "endMs": 3144250,
  "text": "今は俺のことが怖いんじゃないですか"
 },
 {
  "sourceIndex": 268,
  "startMs": 3145520,
  "endMs": 3150000,
  "text": "ほら無理しなくていいんです"
 },
 {
  "sourceIndex": 269,
  "startMs": 3151520,
  "endMs": 3160000,
  "text": "ことまでした俺が許されるべきじゃないんですだから"
 },
 {
  "sourceIndex": 270,
  "startMs": 3160000,
  "endMs": 3174250,
  "text": "ハァ君の手で俺を裁いて下さい最後に君の目を見ながら死ねれば本望ですから"
 },
 {
  "sourceIndex": 271,
  "startMs": 3174528,
  "endMs": 3180000,
  "text": "遺書を書くので君が殺人の罪に問われることを"
 },
 {
  "sourceIndex": 272,
  "startMs": 3180528,
  "endMs": 3191048,
  "text": "そんな俺は行くなら君の手でし死なないでほしいなんて"
 },
 {
  "sourceIndex": 273,
  "startMs": 3191048,
  "endMs": 3200250,
  "text": "本当に俺を許すんですかこんな俺を知ってもまだ"
 },
 {
  "sourceIndex": 274,
  "startMs": 3200528,
  "endMs": 3210000,
  "text": "好きって言ってくれるんですか何で君はそんな優しすぎます"
 },
 {
  "sourceIndex": 275,
  "startMs": 3211520,
  "endMs": 3220120,
  "text": "はい死にません君がそばにいてくれるか"
 },
 {
  "sourceIndex": 276,
  "startMs": 3220120,
  "endMs": 3228234,
  "text": "区好き俺も"
 },
 {
  "sourceIndex": 277,
  "startMs": 3228512,
  "endMs": 3240000,
  "text": "大好きです好き好きですずっとずっと君に言いたかった全然言い足りません"
 },
 {
  "sourceIndex": 278,
  "startMs": 3240528,
  "endMs": 3250208,
  "text": "大好きです一生幸せにしますから気が早いなんてことないですよ死ぬまで"
 },
 {
  "sourceIndex": 279,
  "startMs": 3250208,
  "endMs": 3258234,
  "text": "ずっと一緒なんですから間違ってないでしょうハァハァ"
 },
 {
  "sourceIndex": 280,
  "startMs": 3258512,
  "endMs": 3280912,
  "text": "好き大好きですくっすす"
 },
 {
  "sourceIndex": 281,
  "startMs": 3280912,
  "endMs": 3300000,
  "text": "こうすえあっ"
 },
 {
  "sourceIndex": 282,
  "startMs": 3318512,
  "endMs": 3330000,
  "text": "怖くないですかよかった絶対君を傷つけないよ"
 },
 {
  "sourceIndex": 283,
  "startMs": 3330528,
  "endMs": 3339488,
  "text": "優しくしますから"
 },
 {
  "sourceIndex": 284,
  "startMs": 3339488,
  "endMs": 3348234,
  "text": "キス好きですか"
 },
 {
  "sourceIndex": 285,
  "startMs": 3348512,
  "endMs": 3360000,
  "text": "俺も今好きになりました君とのキ幸せで解けそうん"
 },
 {
  "sourceIndex": 286,
  "startMs": 3365520,
  "endMs": 3373880,
  "text": "すみませんシャワー浴びたばかりだから髪濡れてて水冷たいですよね"
 },
 {
  "sourceIndex": 287,
  "startMs": 3373880,
  "endMs": 3382234,
  "text": "あっまた君の体にん"
 },
 {
  "sourceIndex": 288,
  "startMs": 3382512,
  "endMs": 3390000,
  "text": "くっあっ耳"
 },
 {
  "sourceIndex": 289,
  "startMs": 3390528,
  "endMs": 3405480,
  "text": "あかわいいん"
 },
 {
  "sourceIndex": 290,
  "startMs": 3405480,
  "endMs": 3420000,
  "text": "心君耳も弱い"
 },
 {
  "sourceIndex": 291,
  "startMs": 3420528,
  "endMs": 3428768,
  "text": "月じゃあこれは"
 },
 {
  "sourceIndex": 292,
  "startMs": 3428768,
  "endMs": 3450000,
  "text": "うんかわいすぎて心配"
 },
 {
  "sourceIndex": 293,
  "startMs": 3450528,
  "endMs": 3459848,
  "text": "はぁ胸をもうこんなに"
 },
 {
  "sourceIndex": 294,
  "startMs": 3459848,
  "endMs": 3468234,
  "text": "服の上から形結構分かちょいますねここ"
 },
 {
  "sourceIndex": 295,
  "startMs": 3468512,
  "endMs": 3480000,
  "text": "ああかわいい"
 },
 {
  "sourceIndex": 296,
  "startMs": 3480528,
  "endMs": 3490488,
  "text": "乳首硬くなってきましたねれしい乳首も耳も好きですか"
 },
 {
  "sourceIndex": 297,
  "startMs": 3490488,
  "endMs": 3499226,
  "text": "いっぱい触りますね服脱ぎましょうか"
 },
 {
  "sourceIndex": 298,
  "startMs": 3499536,
  "endMs": 3510000,
  "text": "あやっぱりこのいつも着てる服似合ってるから脱がすのもったいない"
 },
 {
  "sourceIndex": 299,
  "startMs": 3510528,
  "endMs": 3518528,
  "text": "でも今日は君に直接触れたいから脱がますねね"
 },
 {
  "sourceIndex": 300,
  "startMs": 3518528,
  "endMs": 3530250,
  "text": "いっぱい君の洋服があるからまた今度気に入ったのがあれば来てくれるとうれしいです"
 },
 {
  "sourceIndex": 301,
  "startMs": 3530528,
  "endMs": 3555520,
  "text": "ああ心の声君の肌熱いですねあっ乳首やっぱり大きくなった"
 },
 {
  "sourceIndex": 302,
  "startMs": 3555520,
  "endMs": 3570000,
  "text": "かわいい乳首座れるの好きですか?"
 },
 {
  "sourceIndex": 303,
  "startMs": 3571520,
  "endMs": 3582160,
  "text": "バレましたか君に好きって言わせたくてわざと何回も聞いてました嫌でしたか?"
 },
 {
  "sourceIndex": 304,
  "startMs": 3582160,
  "endMs": 3590250,
  "text": "俺も好き好きです誓い"
 },
 {
  "sourceIndex": 305,
  "startMs": 3590528,
  "endMs": 3600000,
  "text": "倍気持ちよくなりましょうねうん"
 },
 {
  "sourceIndex": 306,
  "startMs": 3603536,
  "endMs": 3615440,
  "text": "舌で転がしたらすわれるのも好きですか"
 },
 {
  "sourceIndex": 307,
  "startMs": 3615440,
  "endMs": 3630000,
  "text": "耳なめながらちくねふカリカリ"
 },
 {
  "sourceIndex": 308,
  "startMs": 3630528,
  "endMs": 3640168,
  "text": "からピクッ"
 },
 {
  "sourceIndex": 309,
  "startMs": 3640168,
  "endMs": 3648234,
  "text": "乳首さっきより大きくなったかわいくなります"
 },
 {
  "sourceIndex": 310,
  "startMs": 3648512,
  "endMs": 3660000,
  "text": "ゆびでギュッとつまめるからキュッこれもすきなんだほらぎゅっ"
 },
 {
  "sourceIndex": 311,
  "startMs": 3660528,
  "endMs": 3680250,
  "text": "キューああああかわいい声出てますねうん"
 },
 {
  "sourceIndex": 312,
  "startMs": 3680528,
  "endMs": 3690000,
  "text": "乳首甘がみしながらぎツうん"
 },
 {
  "sourceIndex": 313,
  "startMs": 3690528,
  "endMs": 3702448,
  "text": "ビンタ信があったゴリゴリとしてますね"
 },
 {
  "sourceIndex": 314,
  "startMs": 3702448,
  "endMs": 3712234,
  "text": "かわいい栗リみたいにすったりしごえたりするのも好きなんですか"
 },
 {
  "sourceIndex": 315,
  "startMs": 3723536,
  "endMs": 3726114,
  "text": "ああ、かわいい"
 },
 {
  "sourceIndex": 316,
  "startMs": 3726114,
  "endMs": 3734710,
  "text": "もっともっと君に好きって言ってほしいです"
 },
 {
  "sourceIndex": 317,
  "startMs": 3734710,
  "endMs": 3737720,
  "text": "下、足閉じないで"
 },
 {
  "sourceIndex": 318,
  "startMs": 3737720,
  "endMs": 3741441,
  "text": "さゆっくりしますから"
 },
 {
  "sourceIndex": 319,
  "startMs": 3741441,
  "endMs": 3750000,
  "text": "あちゃんと濡れてますねほんとに俺で感じてくれて"
 },
 {
  "sourceIndex": 320,
  "startMs": 3751520,
  "endMs": 3760200,
  "text": "うれしくて泣きそう優しく優しくしますから"
 },
 {
  "sourceIndex": 321,
  "startMs": 3760200,
  "endMs": 3768234,
  "text": "ああゆっくりなぞってっくりソりな"
 },
 {
  "sourceIndex": 322,
  "startMs": 3768512,
  "endMs": 3780000,
  "text": "指もゆっくり昨日はおれの小にぽっかり空いてたな"
 },
 {
  "sourceIndex": 323,
  "startMs": 3780528,
  "endMs": 3783224,
  "text": "もう狭くなってますね"
 },
 {
  "sourceIndex": 324,
  "startMs": 3783224,
  "endMs": 3788888,
  "text": "昨日どこが一番気持ちよかったか覚えてますか"
 },
 {
  "sourceIndex": 325,
  "startMs": 3788888,
  "endMs": 3799226,
  "text": "ここここですよねほら中指でトントンって気持ちいいですか"
 },
 {
  "sourceIndex": 326,
  "startMs": 3799536,
  "endMs": 3810000,
  "text": "そっとしてあげますからねうって声抑さえないで顎引っ"
 },
 {
  "sourceIndex": 327,
  "startMs": 3810528,
  "endMs": 3825000,
  "text": "ダメですよ上向いてちゃんとはってそうそうかわいいあ"
 },
 {
  "sourceIndex": 328,
  "startMs": 3825000,
  "endMs": 3840000,
  "text": "指締めつけて上手足ビンってしてもいいですよギュて万個力入れてそうオレの指意識してドン"
 },
 {
  "sourceIndex": 329,
  "startMs": 3840528,
  "endMs": 3848968,
  "text": "トントンってあっあっあっあそうそうじょうずいいですよいってこれをいっ"
 },
 {
  "sourceIndex": 330,
  "startMs": 3848968,
  "endMs": 3861242,
  "text": "倍感して言ってくださいあっう"
 },
 {
  "sourceIndex": 331,
  "startMs": 3861520,
  "endMs": 3870000,
  "text": "はっはあっ"
 },
 {
  "sourceIndex": 332,
  "startMs": 3870528,
  "endMs": 3885040,
  "text": "あっあっあっ"
 },
 {
  "sourceIndex": 333,
  "startMs": 3885040,
  "endMs": 3900000,
  "text": "ああすごいかわいいき癖ついちゃったあっまだたくさん出てますはあ"
 },
 {
  "sourceIndex": 334,
  "startMs": 3900528,
  "endMs": 3908528,
  "text": "かわいい本当にかわいすぎた"
 },
 {
  "sourceIndex": 335,
  "startMs": 3908528,
  "endMs": 3921242,
  "text": "頭クルクラするいっぱい俺れで感じてくれてすごくうれしいです"
 },
 {
  "sourceIndex": 336,
  "startMs": 3921520,
  "endMs": 3930000,
  "text": "あっああ俺のアタ"
 },
 {
  "sourceIndex": 337,
  "startMs": 3930528,
  "endMs": 3942063,
  "text": "気付いてたんですね君にずっと触ってたからもうこんなになって精子?"
 },
 {
  "sourceIndex": 338,
  "startMs": 3942063,
  "endMs": 3945040,
  "text": "込んで膨れてるあ"
 },
 {
  "sourceIndex": 339,
  "startMs": 3945040,
  "endMs": 3960000,
  "text": "嫌になったら絶対絶対言ってくださいねもう君にひどいことをしたくないんです優しくしたいんです俺の大事ないやそれ以上の存在ですから"
 },
 {
  "sourceIndex": 340,
  "startMs": 3962512,
  "endMs": 3970512,
  "text": "ずっと一緒にいてくださいハァ"
 },
 {
  "sourceIndex": 341,
  "startMs": 3970512,
  "endMs": 3979226,
  "text": "あっあっ"
 },
 {
  "sourceIndex": 342,
  "startMs": 3979536,
  "endMs": 3990000,
  "text": "ああきついけどとろトロってああ"
 },
 {
  "sourceIndex": 343,
  "startMs": 3990528,
  "endMs": 3998568,
  "text": "きっとあったつらくないですか"
 },
 {
  "sourceIndex": 344,
  "startMs": 3998568,
  "endMs": 4008234,
  "text": "はああはあん"
 },
 {
  "sourceIndex": 345,
  "startMs": 4008512,
  "endMs": 4020000,
  "text": "ゆっくりさっき君が好きだったとこ俺ので濡らしていきましょうね"
 },
 {
  "sourceIndex": 346,
  "startMs": 4021520,
  "endMs": 4050000,
  "text": "あっぁゆっくりも気持ちいいうんここ手前のどこきっと"
 },
 {
  "sourceIndex": 347,
  "startMs": 4051520,
  "endMs": 4059840,
  "text": "まあゆっくりゆっくりめ"
 },
 {
  "sourceIndex": 348,
  "startMs": 4059840,
  "endMs": 4068234,
  "text": "あもうダメやめますかはあ"
 },
 {
  "sourceIndex": 349,
  "startMs": 4068512,
  "endMs": 4080000,
  "text": "かわいすぎるおれのことたくさん欲しがってくれてほんと幸せかわいすぎです"
 },
 {
  "sourceIndex": 350,
  "startMs": 4080528,
  "endMs": 4089968,
  "text": "んっ一回俺でいっぱいになった"
 },
 {
  "sourceIndex": 351,
  "startMs": 4089968,
  "endMs": 4098234,
  "text": "そんな締めつけないでああ行きそうかあああ"
 },
 {
  "sourceIndex": 352,
  "startMs": 4098512,
  "endMs": 4110000,
  "text": "ああ俺も気持ちす好きですあっ"
 },
 {
  "sourceIndex": 353,
  "startMs": 4110528,
  "endMs": 4125360,
  "text": "ビビクビクってまたいっぱい言って気持ちよかったんだあっ"
 },
 {
  "sourceIndex": 354,
  "startMs": 4125360,
  "endMs": 4140000,
  "text": "ああ君もずっと"
 },
 {
  "sourceIndex": 355,
  "startMs": 4140528,
  "endMs": 4155200,
  "text": "ジンですかまた行く射生されながら行った行く行くってあその声い来おおまだ出てるかそうたくさん来い"
 },
 {
  "sourceIndex": 356,
  "startMs": 4155200,
  "endMs": 4170000,
  "text": "聞かせてあ会って上向いてちゃんと声たくさんくださいそうあ好き好き低いてあかわいすぎるもっとずっといたい"
 },
 {
  "sourceIndex": 357,
  "startMs": 4170528,
  "endMs": 4182248,
  "text": "いくいくおれすしぶり取られあああああ"
 },
 {
  "sourceIndex": 358,
  "startMs": 4182248,
  "endMs": 4191242,
  "text": "ああうん"
 },
 {
  "sourceIndex": 359,
  "startMs": 4191520,
  "endMs": 4200000,
  "text": "ググうん"
 },
 {
  "sourceIndex": 360,
  "startMs": 4201520,
  "endMs": 4215800,
  "text": "ああやっぱりダメですね気持ちよすぎて途中から抑えられなくなってハァハァ"
 },
 {
  "sourceIndex": 361,
  "startMs": 4215800,
  "endMs": 4230000,
  "text": "俺で気持ちよくなってくれて嬉しい俺もすごくよかったです泣きますねあっ"
 },
 {
  "sourceIndex": 362,
  "startMs": 4230528,
  "endMs": 4238888,
  "text": "えっ確かにまだ硬いままですけど奥まで"
 },
 {
  "sourceIndex": 363,
  "startMs": 4238888,
  "endMs": 4253226,
  "text": "それはダメですもう君を傷つけることはしたくないし全部入れたら昨日みたいに君をぐちゃぐちゃにしてしまいます"
 },
 {
  "sourceIndex": 364,
  "startMs": 4253536,
  "endMs": 4260000,
  "text": "な何ですかその目"
 },
 {
  "sourceIndex": 365,
  "startMs": 4260528,
  "endMs": 4270008,
  "text": "そんなかわいい目で見ないでくださいあああ"
 },
 {
  "sourceIndex": 366,
  "startMs": 4270008,
  "endMs": 4278234,
  "text": "う。はあもう"
 },
 {
  "sourceIndex": 367,
  "startMs": 4278512,
  "endMs": 4290000,
  "text": "かわいすぎて死んじゃいませんっ"
 },
 {
  "sourceIndex": 368,
  "startMs": 4291520,
  "endMs": 4305920,
  "text": "ァ足持ち上げて上から体重かけますよああああ"
 },
 {
  "sourceIndex": 369,
  "startMs": 4305920,
  "endMs": 4320000,
  "text": "ああ少しずつ入ってく入れただけでまた中肉ついて痛"
 },
 {
  "sourceIndex": 370,
  "startMs": 4320528,
  "endMs": 4330242,
  "text": "やってってるんですかかわいい"
 },
 {
  "sourceIndex": 371,
  "startMs": 4330242,
  "endMs": 4345242,
  "text": "もう少しもう少し視力を上げてそう上から押し込んであげますからあっ"
 },
 {
  "sourceIndex": 372,
  "startMs": 4345520,
  "endMs": 4350000,
  "text": "うっあっあっあっああ"
 },
 {
  "sourceIndex": 373,
  "startMs": 4350528,
  "endMs": 4365040,
  "text": "ああ入ったああすごいおれのチ号入ったままちょろちょろってしふいちゃった"
 },
 {
  "sourceIndex": 374,
  "startMs": 4365040,
  "endMs": 4373642,
  "text": "びっくりしちゃいましたよねあかわいすぎるほんと"
 },
 {
  "sourceIndex": 375,
  "startMs": 4373642,
  "endMs": 4380000,
  "text": "がまんできないごごめんなさいあもう"
 },
 {
  "sourceIndex": 376,
  "startMs": 4380528,
  "endMs": 4395160,
  "text": "ずっととまれないあくびくってるぐちゃぐちゃになってるのにギュッしめつけてきてきみにあされてる"
 },
 {
  "sourceIndex": 377,
  "startMs": 4395160,
  "endMs": 4419968,
  "text": "で分かる両思いセックスってすごい幸せすぎて怖いもっともっと君を感じたいいっぱいキスしてくださいヨーモイキザームセックスああっ"
 },
 {
  "sourceIndex": 378,
  "startMs": 4419968,
  "endMs": 4428234,
  "text": "あっあっあっ"
 },
 {
  "sourceIndex": 379,
  "startMs": 4428512,
  "endMs": 4440000,
  "text": "絞られるみたいにギューておお気持ちいいかまた行く行くってそればっかりおかしくなる"
 },
 {
  "sourceIndex": 380,
  "startMs": 4440528,
  "endMs": 4455280,
  "text": "大丈夫俺が死んでも一生そばにいるって言ったでしょああああまた上がってきたです"
 },
 {
  "sourceIndex": 381,
  "startMs": 4455280,
  "endMs": 4470000,
  "text": "君を思って作られた寿司全部て君もまた行くんですかギュ足行くまた行く"
 },
 {
  "sourceIndex": 382,
  "startMs": 4470528,
  "endMs": 4479328,
  "text": "おオペも絶対やばいすックデです"
 },
 {
  "sourceIndex": 383,
  "startMs": 4479328,
  "endMs": 4488234,
  "text": "よしあっ"
 },
 {
  "sourceIndex": 384,
  "startMs": 4488512,
  "endMs": 4500000,
  "text": "ああ今まで一番し地球まで"
 },
 {
  "sourceIndex": 385,
  "startMs": 4500528,
  "endMs": 4509168,
  "text": "あそこは深呼ドドクドクしてるのを感じますがああああああ"
 },
 {
  "sourceIndex": 386,
  "startMs": 4509168,
  "endMs": 4518234,
  "text": "君の中に全部注いであますから熱うう"
 },
 {
  "sourceIndex": 387,
  "startMs": 4518512,
  "endMs": 4530000,
  "text": "膨らんでるおれのせいで赤ちゃん埋め尽くしちゃったあすみませんあああグき"
 },
 {
  "sourceIndex": 388,
  "startMs": 4530528,
  "endMs": 4539168,
  "text": "ずっとビクビクしておなかだけ最後までああちょっと激打チ"
 },
 {
  "sourceIndex": 389,
  "startMs": 4539168,
  "endMs": 4550250,
  "text": "マンゴ閉めてあああっあっああああ"
 },
 {
  "sourceIndex": 390,
  "startMs": 4550528,
  "endMs": 4560000,
  "text": "あ気持ちいいはあすげえ"
 },
 {
  "sourceIndex": 391,
  "startMs": 4560528,
  "endMs": 4570808,
  "text": "大好きおれを見て今君を見通としてるのは"
 },
 {
  "sourceIndex": 392,
  "startMs": 4570808,
  "endMs": 4576095,
  "text": "誰か一番君を愛してるのは誰か"
 },
 {
  "sourceIndex": 393,
  "startMs": 4576095,
  "endMs": 4580250,
  "text": "ちゃんと見て下さい、君を"
 },
 {
  "sourceIndex": 394,
  "startMs": 4580528,
  "endMs": 4590000,
  "text": "目に俺をずっと映した好き大好きですハァ"
 },
 {
  "sourceIndex": 395,
  "startMs": 4590528,
  "endMs": 4598928,
  "text": "はぁこのままずっと"
 },
 {
  "sourceIndex": 396,
  "startMs": 4598928,
  "endMs": 4608234,
  "text": "残していたああ"
 },
 {
  "sourceIndex": 397,
  "startMs": 4608512,
  "endMs": 4631126,
  "text": "うんうん"
 },
 {
  "sourceIndex": 398,
  "startMs": 4640528,
  "endMs": 4650000,
  "text": "あっあっッ"
 },
 {
  "sourceIndex": 399,
  "startMs": 4651520,
  "endMs": 4659800,
  "text": "夢じゃないはぁ幸せうん"
 },
 {
  "sourceIndex": 400,
  "startMs": 4659800,
  "endMs": 4669226,
  "text": "心の声はぁ久しぶりに体が軽い"
 },
 {
  "sourceIndex": 401,
  "startMs": 4669536,
  "endMs": 4680000,
  "text": "あれもうたってない治ったのかあっ"
 },
 {
  "sourceIndex": 402,
  "startMs": 4680528,
  "endMs": 4689208,
  "text": "あ起こしちゃいましたかいやあのそれが治って"
 },
 {
  "sourceIndex": 403,
  "startMs": 4689208,
  "endMs": 4698234,
  "text": "たみたいではい君のおかげですその弾の"
 },
 {
  "sourceIndex": 404,
  "startMs": 4698512,
  "endMs": 4710000,
  "text": "大きさも元に戻っていたのでもう大丈夫だと思いますえチンコの大きさは特別大きくなってたわけじゃなくて"
 },
 {
  "sourceIndex": 405,
  "startMs": 4710528,
  "endMs": 4718848,
  "text": "あれがいつものサイズなんですけど何か問題ありましたか"
 },
 {
  "sourceIndex": 406,
  "startMs": 4718848,
  "endMs": 4728234,
  "text": "ちょっと逃げないで下さいダメです逃がしませんからずっと一緒に"
 },
 {
  "sourceIndex": 407,
  "startMs": 4728512,
  "endMs": 4740000,
  "text": "いてくれるって言ったでしょ明日婚姻届もらっていきましょうねあっでも今かわいいやつとかあるんでしたっけ"
 },
 {
  "sourceIndex": 408,
  "startMs": 4741520,
  "endMs": 4755520,
  "text": "はい本気ですよまずは恋人からってえっなんでですか絶対結婚するのに?"
 },
 {
  "sourceIndex": 409,
  "startMs": 4755520,
  "endMs": 4770000,
  "text": "心の準備ってそんな俺は明日にでも指輪を買いに行こうと思ってたんですよなのに君は俺のこと"
 },
 {
  "sourceIndex": 410,
  "startMs": 4770528,
  "endMs": 4780368,
  "text": "本気じゃなかったんですねほんとですか絶対結婚してくれますか?"
 },
 {
  "sourceIndex": 411,
  "startMs": 4780368,
  "endMs": 4791242,
  "text": "うれしいです君の左手の薬指は俺がしっかり予約済みですから"
 },
 {
  "sourceIndex": 412,
  "startMs": 4791520,
  "endMs": 4795053,
  "text": "約束ですよ"
 },
 {
  "sourceIndex": 413,
  "startMs": 4795053,
  "endMs": 4800000,
  "text": "はあ大好きです"
 },
 {
  "sourceIndex": 414,
  "startMs": 4812528,
  "endMs": 4820528,
  "text": "珍しいですね美晴からかけてくるなんてハ兄さんは相変わらず堅いな"
 },
 {
  "sourceIndex": 415,
  "startMs": 4820528,
  "endMs": 4830000,
  "text": "でも元気そうでよかった前に連絡来たときはかなり苦しそうだったしあまあ"
 },
 {
  "sourceIndex": 416,
  "startMs": 4830528,
  "endMs": 4845160,
  "text": "のおかげでああ治ってよかったねラブラブ好き好き両思いhで助けてもらったんでしょえ?あ"
 },
 {
  "sourceIndex": 417,
  "startMs": 4845160,
  "endMs": 4860000,
  "text": "の聞いてろいやだって兄さん途中で電話切っちゃうからでもよかったね彼女さんに受け入れてもらえてそれはそうですね"
 },
 {
  "sourceIndex": 418,
  "startMs": 4860528,
  "endMs": 4863752,
  "text": "大切にします?"
 },
 {
  "sourceIndex": 419,
  "startMs": 4863752,
  "endMs": 4867514,
  "text": "なんやなでもも"
 },
 {
  "sourceIndex": 420,
  "startMs": 4867514,
  "endMs": 4875040,
  "text": "つきあったばっかりなんでしょ"
 },
 {
  "sourceIndex": 421,
  "startMs": 4875040,
  "endMs": 4879141,
  "text": "もう結婚見据えてる感じなんだなって"
 },
 {
  "sourceIndex": 422,
  "startMs": 4879141,
  "endMs": 4880830,
  "text": "あ当たり前です"
 },
 {
  "sourceIndex": 423,
  "startMs": 4880830,
  "endMs": 4890000,
  "text": "早く彼女にかかる全てのものを俺が背負いたくてスマホの料金も家賃もそれに戸籍も"
 },
 {
  "sourceIndex": 424,
  "startMs": 4890528,
  "endMs": 4905320,
  "text": "一緒にしたいのに彼女に止められてしまってもう少し心の準備がって兄さん束縛しすぎると逃げられるよ彼女のsnsとかずっと見てない"
 },
 {
  "sourceIndex": 425,
  "startMs": 4905320,
  "endMs": 4916833,
  "text": "あとずっと彼女のこと見守りたいからってgpsつけようとしたり気をつけた方がいいよ"
 },
 {
  "sourceIndex": 426,
  "startMs": 4916833,
  "endMs": 4920000,
  "text": "気持ちは分かるけど職場"
 },
 {
  "sourceIndex": 427,
  "startMs": 4920528,
  "endMs": 4935280,
  "text": "嫌われるらしいしあそんなことはないと思うけどまあ気に留めておきますうんま兄さんには幸せになってほしいし"
 },
 {
  "sourceIndex": 428,
  "startMs": 4935280,
  "endMs": 4942974,
  "text": "あそうそう俺も今度そっち行くからまた連絡するね"
 },
 {
  "sourceIndex": 429,
  "startMs": 4942974,
  "endMs": 4946654,
  "text": "え上京してくるんですか!"
 },
 {
  "sourceIndex": 430,
  "startMs": 4946654,
  "endMs": 4950000,
  "text": "?うんまあねそれでこう"
 },
 {
  "sourceIndex": 431,
  "startMs": 4952512,
  "endMs": 4964194,
  "text": "喜ぶっていうかデートっていうかそういうのに向いてそうな場所知ってたりする?"
 },
 {
  "sourceIndex": 432,
  "startMs": 4964194,
  "endMs": 4967440,
  "text": "いやだから違うからね"
 },
 {
  "sourceIndex": 433,
  "startMs": 4967440,
  "endMs": 4980000,
  "text": "彼女とかじゃないしハハハ焦りすぎ俺も最近彼女といんなとこ行ってるのでいいデートスポットたくさん紹介してあげますね"
 },
 {
  "sourceIndex": 434,
  "startMs": 4981520,
  "endMs": 4989520,
  "text": "気に入ったところだと花火と夜景がきれいに見えるレストランがあってああ彼女の瞳に光"
 },
 {
  "sourceIndex": 435,
  "startMs": 4989520,
  "endMs": 4998234,
  "text": "広がる花火は本当にきれいで兄さんめっちゃのろけるじゃんちょっと怒られてか"
 },
 {
  "sourceIndex": 436,
  "startMs": 4998512,
  "endMs": 5006861,
  "text": "俺も早く姉ちゃんに会いたいなぁ"
 }
]